      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "@concat('select DISTINCT CDSViewName, REGEXP_REPLACE(ODPName, ''\\$[EFPT]'', '''') AS ODPName, KeyFields from extractionMetadata em join systemDetails sd on em.SystemName = sd.SystemName where em.Type = ''FACT'' and em.inScope = 1 and sd.SourceType = ''SAP'' and sd.ConnectionType = ''OpenMirroring'' and sd.SystemType = ''S4HANA'' and em.SystemName = ''', pipeline().parameters.System_Name, ''' and (''',pipeline().parameters.CdsViewNames, ''' = '''' OR CDSViewName IN (SELECT LTRIM(RTRIM(value)) FROM STRING_SPLIT(''', pipeline().parameters.CdsViewNames, ''', '','')))')",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "ei_metadata_database",
